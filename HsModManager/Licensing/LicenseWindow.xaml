<Window x:Class="HsModManager.Licensing.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HsMod Manager · 卡密验证"
        Width="560"
        Height="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#EEF3F8"
        FontFamily="Microsoft YaHei UI"
        ContentRendered="LicenseWindow_ContentRendered">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2775D1"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#19599F"/>
        <SolidColorBrush x:Key="TextBrush" Color="#19344F"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#60758A"/>
        <SolidColorBrush x:Key="LineBrush" Color="#DFE5EF"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#234A72"/>
            <Setter Property="Background" Value="#EEF4FF"/>
            <Setter Property="BorderBrush" Value="#C8D9F3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E0EBFC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,17">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="42"
                        Height="42"
                        Background="#EAF2FD"
                        BorderBrush="#C8D9F3"
                        BorderThickness="1"
                        CornerRadius="10">
                    <TextBlock Text="HS"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="Bold"
                               FontSize="15"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="HsMod Manager"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="19"
                               FontWeight="Bold"/>
                    <TextBlock Text="安全验证"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="24,20,24,24"
                Padding="20"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="请输入卡密"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="18"
                           FontWeight="Bold"/>
                <TextBlock Grid.Row="1"
                           Margin="0,5,0,13"
                           Text="验证通过后才会进入管理器。"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="卡密"
                               Width="48"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="KeyTextBox"
                             Grid.Column="1"
                             Height="38"
                             Padding="10,7"
                             MaxLength="16"
                             CharacterCasing="Upper"
                             VerticalContentAlignment="Center"
                             Background="White"
                             Foreground="{StaticResource TextBrush}"
                             CaretBrush="{StaticResource TextBrush}"
                             BorderBrush="#C8D0DC"
                             BorderThickness="1"
                             FontSize="14"
                             ToolTip="8 位数字或字母"/>
                </Grid>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Row="3"
                           Margin="48,10,0,8"
                           Text="请输入 8 位数字或字母。"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Top"/>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="132"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ExitButton"
                            Grid.Column="1"
                            Content="退出"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsCancel="True"
                            Click="ExitButton_Click"/>
                    <Button x:Name="ValidateButton"
                            Grid.Column="3"
                            Content="验证并进入"
                            IsDefault="True"
                            Click="ValidateButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
