<Window x:Class="HsModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:HsModManager.Models"
        xmlns:controls="clr-namespace:HsModManager.Controls"
        mc:Ignorable="d"
        Title="HsMod Manager"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        Background="#EEF3F8"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2775D1"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#19599F"/>
        <SolidColorBrush x:Key="TextBrush" Color="#19344F"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#60758A"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LineBrush" Color="#DFE5EF"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentDarkBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Root" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#234A72"/>
            <Setter Property="Background" Value="#EEF4FF"/>
            <Setter Property="BorderBrush" Value="#C8D9F3"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#C2413A"/>
            <Setter Property="BorderBrush" Value="#A73530"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DangerRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DangerRoot" Property="Background" Value="#A73530"/>
                                <Setter TargetName="DangerRoot" Property="BorderBrush" Value="#8F2D29"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DangerRoot" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DangerRoot" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="#C8D0DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#C8D0DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#234A72"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#294C6A"/>
            <Setter Property="Background" Value="#FAFCFE"/>
            <Setter Property="Padding" Value="9,7"/>
        </Style>

        <Style x:Key="EffectTipStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B42318"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#274C6B"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <TextBlock Text="HsMod Manager" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="安装、桥接、实时配置和皮肤切换" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ConnectButton" Content="连接炉石客户端" Click="ConnectButton_Click" Margin="0,0,10,0"/>
                    <Border Background="#ECFDF3" BorderBrush="#A6F4C5" BorderThickness="1" CornerRadius="8" Padding="12,8">
                        <TextBlock Text="{Binding ConnectionText}" Foreground="#067647"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="20">
            <TabItem Header="一键安装">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F3F7FC">
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="自动寻找炉石客户端" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="会从注册表、Battle.net 线索和常见安装目录查找。本页不会覆盖已有 BepInEx 目录。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="InstallPathTextBox" Grid.Column="0" MinWidth="360" ToolTip="炉石客户端根目录"/>
                                        <Button x:Name="BrowseButton" Grid.Column="1" Content="选择目录" Style="{StaticResource SecondaryButtonStyle}" Click="BrowseButton_Click" Margin="10,0,0,0"/>
                                        <Button x:Name="DetectButton" Grid.Column="2" Content="自动寻找" Click="DetectButton_Click" Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="一键安装 HsMod" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="已有 BepInEx 时只追加本插件和缺失运行库；没有 BepInEx 时会尝试下载 x64 BepInEx 5。安装完成后会弹出提醒。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,16"/>
                                    <TextBlock Text="安装或卸载后需要重新启动炉石客户端。" Style="{StaticResource EffectTipStyle}" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="1.15*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="InstallButton"
                                                Grid.Column="0"
                                                Content="一键安装 / 更新 HsMod"
                                                FontSize="18"
                                                Padding="22,14"
                                                Click="InstallButton_Click"
                                                Margin="0,0,10,0"/>
                                        <Button x:Name="UninstallButton"
                                                Grid.Column="1"
                                                Content="卸载 HsMod"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Padding="18,14"
                                                Click="UninstallButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="安装日志" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button x:Name="CopyInstallLogButton"
                                            Grid.Column="1"
                                            Content="复制全部"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,6"
                                            Click="CopyInstallLogButton_Click"/>
                                </Grid>
                                <TextBox x:Name="InstallLogTextBox"
                                         Height="430"
                                         Margin="0,12,0,0"
                                         Padding="10"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="Microsoft YaHei UI"
                                         Foreground="#294C6A"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="实时配置">
                <Grid Background="#F4F8F5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ConfigSearchTextBox" Grid.Column="0" ToolTip="搜索配置项" TextChanged="ConfigSearchTextBox_TextChanged"/>
                            <CheckBox x:Name="ShowAdvancedCheckBox" Grid.Column="1" Content="显示高级项" VerticalAlignment="Center" Margin="14,0" Checked="ShowAdvancedCheckBox_Changed" Unchecked="ShowAdvancedCheckBox_Changed"/>
                            <Button x:Name="ReloadConfigButton" Grid.Column="2" Content="重新读取配置" Click="ReloadConfigButton_Click"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ConfigGroupsPanel" Margin="2"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="皮肤切换">
                <Grid Background="#F8F5FA">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="皮肤设置" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="英雄等对局资源从下一局生效；选择自己的宠物时会自动开启上游所需的酒馆藏品支持。" Style="{StaticResource EffectTipStyle}"/>
                            </StackPanel>
                            <Button x:Name="RefreshSkinListButton"
                                    Grid.Column="1"
                                    Content="刷新皮肤列表"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="18,10"
                                    Margin="0,0,10,0"
                                    Click="RefreshSkinListButton_Click"/>
                            <Button x:Name="SaveAndApplySkinsButton"
                                    Grid.Column="2"
                                    Content="保存并应用"
                                    Padding="24,10"
                                    Click="SaveAndApplySkinsButton_Click"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="2">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="英雄皮肤" FontSize="18" FontWeight="Bold"/>
                                    <ItemsControl x:Name="ClassSkinItemsControl" Margin="0,14,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:ClassSkinSelection}">
                                                <StackPanel Width="330" Margin="0,0,18,14">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                    <controls:SearchableSkinComboBox ItemsSource="{Binding Options}"
                                                                                       SelectedId="{Binding SelectedId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                       IsEnabled="{Binding IsAvailable}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="其他皮肤" FontSize="18" FontWeight="Bold"/>
                                    <UniformGrid Columns="2" Margin="0,14,0,0">
                                        <StackPanel Margin="0,0,12,12">
                                            <TextBlock Text="幸运币"/>
                                            <controls:SearchableSkinComboBox x:Name="CoinComboBox" Tag="skinCoin"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,12">
                                            <TextBlock Text="卡背"/>
                                            <controls:SearchableSkinComboBox x:Name="CardBackComboBox" Tag="skinCardBack"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,12">
                                            <TextBlock Text="游戏桌面 / 对战面板"/>
                                            <controls:SearchableSkinComboBox x:Name="BoardComboBox" Tag="skinBoard"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,12">
                                            <TextBlock Text="酒馆战斗面板"/>
                                            <controls:SearchableSkinComboBox x:Name="BgsBoardComboBox" Tag="skinBgsBoard"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,12">
                                            <TextBlock Text="酒馆击杀特效"/>
                                            <controls:SearchableSkinComboBox x:Name="BgsFinisherComboBox" Tag="skinBgsFinisher"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,12">
                                            <TextBlock Text="鲍勃皮肤"/>
                                            <controls:SearchableSkinComboBox x:Name="BobComboBox" Tag="skinBob"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,12">
                                            <TextBlock Text="宠物"/>
                                            <controls:SearchableSkinComboBox x:Name="PetComboBox" Tag="skinPet"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,12">
                                            <TextBlock Text="对手宠物"/>
                                            <controls:SearchableSkinComboBox x:Name="OpposingPetComboBox" Tag="skinOpposingPet"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

        </TabControl>

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" Height="7" IsIndeterminate="{Binding IsBusy}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
