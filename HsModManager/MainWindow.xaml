<Window x:Class="HsModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:HsModManager.Models"
        mc:Ignorable="d"
        Title="HsMod Manager"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        Background="#F5F7FA"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2775D1"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#19599F"/>
        <SolidColorBrush x:Key="TextBrush" Color="#172033"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#667085"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LineBrush" Color="#DFE5EF"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentDarkBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Root" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#EEF4FF"/>
            <Setter Property="BorderBrush" Value="#C8D9F3"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="#C8D0DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#C8D0DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <TextBlock Text="HsMod Manager" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="安装、桥接、实时配置和皮肤切换" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ConnectButton" Content="连接炉石客户端" Click="ConnectButton_Click" Margin="0,0,10,0"/>
                    <Border Background="#ECFDF3" BorderBrush="#A6F4C5" BorderThickness="1" CornerRadius="8" Padding="12,8">
                        <TextBlock Text="{Binding ConnectionText}" Foreground="#067647"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="20">
            <TabItem Header="一键安装">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="自动寻找炉石客户端" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="会从注册表、Battle.net 线索和常见安装目录查找。本页不会覆盖已有 BepInEx 目录。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="InstallPathTextBox" Grid.Column="0" MinWidth="360" ToolTip="炉石客户端根目录"/>
                                        <Button x:Name="BrowseButton" Grid.Column="1" Content="选择目录" Style="{StaticResource SecondaryButtonStyle}" Click="BrowseButton_Click" Margin="10,0,0,0"/>
                                        <Button x:Name="DetectButton" Grid.Column="2" Content="自动寻找" Click="DetectButton_Click" Margin="10,0,0,0"/>
                                    </Grid>
                                    <ComboBox x:Name="InstallCandidatesComboBox" DisplayMemberPath="Path" SelectionChanged="InstallCandidatesComboBox_SelectionChanged" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="一键安装 HsMod" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="已有 BepInEx 时只追加本插件和缺失运行库；没有 BepInEx 时会尝试下载 x64 BepInEx 5。安装完成后会弹出提醒。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,16"/>
                                    <Button x:Name="InstallButton" Content="一键安装 / 更新 HsMod" FontSize="18" Padding="22,14" Click="InstallButton_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="安装日志" FontSize="18" FontWeight="Bold"/>
                                <ListBox x:Name="InstallLogListBox" Height="430" Margin="0,12,0,0" BorderBrush="{StaticResource LineBrush}" ItemsSource="{Binding Logs}" DisplayMemberPath="Display"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="实时配置">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ConfigSearchTextBox" Grid.Column="0" ToolTip="搜索配置项" TextChanged="ConfigSearchTextBox_TextChanged"/>
                            <CheckBox x:Name="ShowAdvancedCheckBox" Grid.Column="1" Content="显示高级项" VerticalAlignment="Center" Margin="14,0" Checked="ShowAdvancedCheckBox_Changed" Unchecked="ShowAdvancedCheckBox_Changed"/>
                            <Button x:Name="ReloadConfigButton" Grid.Column="2" Content="重新读取配置" Click="ReloadConfigButton_Click"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ConfigGroupsPanel" Margin="2"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="皮肤切换">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="皮肤设置" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button x:Name="RefreshSkinListButton"
                                    Grid.Column="1"
                                    Content="刷新皮肤列表"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="18,10"
                                    Margin="0,0,10,0"
                                    Click="RefreshSkinListButton_Click"/>
                            <Button x:Name="SaveAndApplySkinsButton"
                                    Grid.Column="2"
                                    Content="保存并应用"
                                    Padding="24,10"
                                    Click="SaveAndApplySkinsButton_Click"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="2">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="英雄皮肤" FontSize="18" FontWeight="Bold"/>
                                    <ItemsControl x:Name="ClassSkinItemsControl" Margin="0,14,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:ClassSkinSelection}">
                                                <StackPanel Width="330" Margin="0,0,18,14">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                    <ComboBox ItemsSource="{Binding Options}"
                                                              DisplayMemberPath="Display"
                                                              SelectedValuePath="Id"
                                                              SelectedValue="{Binding SelectedId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEnabled="{Binding IsAvailable}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="其他皮肤" FontSize="18" FontWeight="Bold"/>
                                    <UniformGrid Columns="2" Margin="0,14,0,0">
                                        <StackPanel Margin="0,0,12,12">
                                            <TextBlock Text="幸运币"/>
                                            <ComboBox x:Name="CoinComboBox" DisplayMemberPath="Display" SelectedValuePath="Id" Tag="skinCoin"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,12">
                                            <TextBlock Text="卡背"/>
                                            <ComboBox x:Name="CardBackComboBox" DisplayMemberPath="Display" SelectedValuePath="Id" Tag="skinCardBack"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,12">
                                            <TextBlock Text="游戏桌面 / 对战面板"/>
                                            <ComboBox x:Name="BoardComboBox" DisplayMemberPath="Display" SelectedValuePath="Id" Tag="skinBoard"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,12">
                                            <TextBlock Text="酒馆战斗面板"/>
                                            <ComboBox x:Name="BgsBoardComboBox" DisplayMemberPath="Display" SelectedValuePath="Id" Tag="skinBgsBoard"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,12">
                                            <TextBlock Text="酒馆击杀特效"/>
                                            <ComboBox x:Name="BgsFinisherComboBox" DisplayMemberPath="Display" SelectedValuePath="Id" Tag="skinBgsFinisher"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,12">
                                            <TextBlock Text="鲍勃皮肤"/>
                                            <ComboBox x:Name="BobComboBox" DisplayMemberPath="Display" SelectedValuePath="Id" Tag="skinBob"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,12">
                                            <TextBlock Text="宠物"/>
                                            <ComboBox x:Name="PetComboBox" DisplayMemberPath="Display" SelectedValuePath="Id" Tag="skinPet"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,12">
                                            <TextBlock Text="对手宠物"/>
                                            <ComboBox x:Name="OpposingPetComboBox" DisplayMemberPath="Display" SelectedValuePath="Id" Tag="skinOpposingPet"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="日志与桥接">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <WrapPanel>
                            <Button x:Name="RefreshStatusButton" Content="刷新状态" Click="RefreshStatusButton_Click" Margin="0,0,10,0"/>
                            <Button x:Name="ReadBepInExLogButton" Content="读取 BepInEx 最近日志" Style="{StaticResource SecondaryButtonStyle}" Click="ReadBepInExLogButton_Click" Margin="0,0,10,0"/>
                            <Button x:Name="ReadMatchLogButton" Content="读取对局日志" Style="{StaticResource SecondaryButtonStyle}" Click="ReadMatchLogButton_Click" Margin="0,0,10,0"/>
                            <Button x:Name="RestartWebButton" Content="重启插件 Web 服务" Style="{StaticResource SecondaryButtonStyle}" Click="RestartWebButton_Click"/>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="1.1*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,14,0">
                            <StackPanel>
                                <TextBlock Text="管理器日志" FontSize="18" FontWeight="Bold"/>
                                <ListBox x:Name="MainLogListBox" ItemsSource="{Binding Logs}" DisplayMemberPath="Display" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="客户端日志 / 状态输出" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                                <TextBox x:Name="RemoteLogTextBox"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap"
                                         FontFamily="Consolas"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" Height="7" IsIndeterminate="{Binding IsBusy}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
